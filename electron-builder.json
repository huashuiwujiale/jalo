{
  "appId": "com.jiale.jalo",
  "productName": "Jalo",
  "directories": { "output": "release", "buildResources": "build-resources" },
  "extraMetadata": { "main": "dist/electron/main.cjs" },
  "files": ["dist/**/*", "package.json", "LICENSE"],
  "asar": true,
  "asarUnpack": ["node_modules/sql.js/dist/*.wasm"],
  "npmRebuild": false,
  "mac": {
    "target": [{ "target": "dmg", "arch": ["arm64"] }],
    "category": "public.app-category.developer-tools",
    "identity": "-",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "notarize": false
  },
  "dmg": {
    "title": "安装 Jalo",
    "sign": false,
    "window": { "width": 600, "height": 380 },
    "contents": [
      { "x": 150, "y": 180 },
      { "x": 450, "y": 180, "type": "link", "path": "/Applications" }
    ]
  },
  "artifactName": "Jalo-${version}-mac-${arch}.${ext}"
}
